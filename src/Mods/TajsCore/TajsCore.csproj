<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsCoiMod>true</IsCoiMod>

    <ModId>TajsCore</ModId>
    <ModVersion>0.1.0</ModVersion>
    <ModDisplayName>Taj's Core</ModDisplayName>
    <ModDescription>Runtime foundation for the Taj's COI mod suite.</ModDescription>
    <ModAuthor>TajemnikTV</ModAuthor>
    <MinGameVersion>0.8.7</MinGameVersion>
    <MaxVerifiedGameVersion>0.8.7b</MaxVerifiedGameVersion>
    <PrimaryModClassName>TajsCoreMod</PrimaryModClassName>

    <AssemblyName>$(ModId)</AssemblyName>
    <RootNamespace>TajsCOI.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PrimaryModDll Include="0Harmony.dll"/>
    <PrimaryModDll Include="TajsCOI.Common.dll"/>
    <PrimaryModDll Include="$(TargetFileName)"/>

    <ProjectReference Include="..\..\Libraries\TajsCOI.Common\TajsCOI.Common.csproj"/>
    <PackageReference Include="Lib.Harmony" Version="2.4.2"/>
    <Reference Include="Mafi.Unity">
      <HintPath>$(COIManagedDir)\Mafi.Unity.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(COIManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIElementsModule">
      <HintPath>$(COIManagedDir)\UnityEngine.UIElementsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>TajsCOI.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
