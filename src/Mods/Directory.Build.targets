<Project>

    <Target Name="ValidateCoiInstall"
            BeforeTargets="ResolveReferences"
            Condition="'$(IsCoiMod)' == 'true'">
        <Error Condition="'$(ModId)' == ''" Text="IsCoiMod=true but ModId is not defined."/>
        <Error Condition="'$(ModVersion)' == ''" Text="IsCoiMod=true but ModVersion is not defined."/>
        <Error Condition="'$(ModDisplayName)' == ''" Text="IsCoiMod=true but ModDisplayName is not defined."/>
        <Error Condition="'$(ModAuthor)' == ''" Text="IsCoiMod=true but ModAuthor is not defined."/>
        <Error Condition="!Exists('$(COIManagedDir)\Mafi.Core.dll')"
               Text="Captain of Industry assemblies were not found at '$(COIManagedDir)'. Set COI_ROOT or edit src\Mods\Directory.Build.props."/>
    </Target>

    <!-- Attach useful build provenance to the assembly without CodeTaskFactory. -->
    <Target Name="CollectBuildMetadata"
            BeforeTargets="GenerateAssemblyInfo"
            Condition="'$(IsCoiMod)' == 'true'">
        <PropertyGroup>
            <_BuildTimestampUtc>$([System.DateTime]::UtcNow.ToString("yyyy-MM-ddTHH:mm:ssZ"))</_BuildTimestampUtc>
        </PropertyGroup>

        <Exec Command="git -C &quot;$(MSBuildProjectDirectory)&quot; rev-parse --short=12 HEAD"
              ConsoleToMSBuild="true"
              IgnoreExitCode="true">
            <Output TaskParameter="ConsoleOutput" ItemName="_GitCommitOutput"/>
        </Exec>

        <PropertyGroup>
            <_GitCommit>@(_GitCommitOutput)</_GitCommit>
            <_GitCommit Condition="'$(_GitCommit)' == ''">unknown</_GitCommit>
        </PropertyGroup>

        <ItemGroup>
            <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
                <_Parameter1>ModVersion</_Parameter1>
                <_Parameter2>$(ModVersion)</_Parameter2>
            </AssemblyAttribute>
            <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
                <_Parameter1>BuildConfiguration</_Parameter1>
                <_Parameter2>$(Configuration)</_Parameter2>
            </AssemblyAttribute>
            <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
                <_Parameter1>BuildTimestampUtc</_Parameter1>
                <_Parameter2>$(_BuildTimestampUtc)</_Parameter2>
            </AssemblyAttribute>
            <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
                <_Parameter1>GitCommit</_Parameter1>
                <_Parameter2>$(_GitCommit)</_Parameter2>
            </AssemblyAttribute>
        </ItemGroup>

        <Message Text="Build metadata: $(ModVersion) | $(Configuration) | git $(_GitCommit) | $(_BuildTimestampUtc)" Importance="High"/>
    </Target>

    <!-- Generate manifest.json from the same properties used for assembly metadata. -->
    <Target Name="GenerateCoiManifest"
            BeforeTargets="BeforeBuild"
            Condition="'$(IsCoiMod)' == 'true'">
        <ItemGroup>
            <_ManifestLines Remove="@(_ManifestLines)"/>
            <_ManifestLines Include="{"/>
            <_ManifestLines Include='  &quot;id&quot;: &quot;$(ModId)&quot;,'/>
            <_ManifestLines Include='  &quot;version&quot;: &quot;$(ModVersion)&quot;,'/>
            <_ManifestLines Include='  &quot;display_name&quot;: &quot;$(ModDisplayName)&quot;,'/>
            <_ManifestLines Include='  &quot;description_short&quot;: &quot;$(ModDescription)&quot;,'/>
            <_ManifestLines Include='  &quot;authors&quot;: &quot;$(ModAuthor)&quot;,'/>
            <_ManifestLines Include='  &quot;primary_dlls&quot;: [&quot;$(TargetFileName)&quot;],'/>
            <_ManifestLines Include='  &quot;min_game_version&quot;: &quot;$(MinGameVersion)&quot;,'/>
            <_ManifestLines Include='  &quot;max_verified_game_version&quot;: &quot;$(MaxVerifiedGameVersion)&quot;,'/>
            <_ManifestLines Include='  &quot;non_locking_dll_load&quot;: true,'/>
            <_ManifestLines Include='  &quot;can_add_to_saved_game&quot;: true,'/>
            <_ManifestLines Include='  &quot;can_remove_from_saved_game&quot;: true'/>
            <_ManifestLines Include="}"/>
        </ItemGroup>

        <WriteLinesToFile File="$(MSBuildProjectDirectory)\manifest.json"
                          Lines="@(_ManifestLines)"
                          Overwrite="true"
                          Encoding="UTF-8"/>

        <Message Text="Generated manifest.json for $(ModId) $(ModVersion)" Importance="High"/>
    </Target>

    <!-- Keep Unity's Assets/DLLs supplied with the latest normal-mod assembly -->
    <Target Name="CopyCoiDllToUnity"
            AfterTargets="Build"
            Condition="'$(IsCoiMod)' == 'true'
                  and '$(CopyToUnityProject)' == 'true'
                  and Exists('$(UnityProjectDir)')">
        <PropertyGroup>
            <_UnityDllDir>$(UnityProjectDir)\Assets\DLLs</_UnityDllDir>
        </PropertyGroup>

        <MakeDir Directories="$(_UnityDllDir)"/>

        <Copy SourceFiles="$(TargetPath)"
              DestinationFolder="$(_UnityDllDir)"
              SkipUnchangedFiles="true"
              OverwriteReadOnlyFiles="true"/>

        <Copy SourceFiles="$(TargetDir)$(TargetName).pdb"
              DestinationFolder="$(_UnityDllDir)"
              SkipUnchangedFiles="true"
              OverwriteReadOnlyFiles="true"
              Condition="Exists('$(TargetDir)$(TargetName).pdb')"/>

        <Copy SourceFiles="$(TargetDir)$(TargetName).xml"
              DestinationFolder="$(_UnityDllDir)"
              SkipUnchangedFiles="true"
              OverwriteReadOnlyFiles="true"
              Condition="'$(Configuration)' == 'Release' and Exists('$(TargetDir)$(TargetName).xml')"/>

        <Message Text="Copied $(TargetFileName) to Unity project: $(_UnityDllDir)" Importance="High"/>
    </Target>

    <!-- Deploy the live mod -->
    <Target Name="DeployCoiMod"
            AfterTargets="Build"
            Condition="'$(IsCoiMod)' == 'true' and '$(DeployToModsFolder)' == 'true'">

        <PropertyGroup>
            <_ModDeployDir>$(COIModsDir)\$(ModId)</_ModDeployDir>
        </PropertyGroup>

        <Message Text="Deploying $(ModId) $(ModVersion) -> $(_ModDeployDir)" Importance="High"/>
        <MakeDir Directories="$(_ModDeployDir)"/>

        <Copy SourceFiles="$(TargetPath)"
              DestinationFolder="$(_ModDeployDir)"
              SkipUnchangedFiles="true"
              OverwriteReadOnlyFiles="true"/>

        <Copy SourceFiles="$(TargetDir)$(TargetName).pdb"
              DestinationFolder="$(_ModDeployDir)"
              SkipUnchangedFiles="true"
              OverwriteReadOnlyFiles="true"
              Condition="Exists('$(TargetDir)$(TargetName).pdb')"/>

        <Copy SourceFiles="$(TargetDir)$(TargetName).xml"
              DestinationFolder="$(_ModDeployDir)"
              SkipUnchangedFiles="true"
              OverwriteReadOnlyFiles="true"
              Condition="Exists('$(TargetDir)$(TargetName).xml')"/>

        <ItemGroup>
            <_ModStaticFiles Remove="@(_ModStaticFiles)"/>
            <_ModStaticFiles Include="$(MSBuildProjectDirectory)\manifest.json"/>
            <_ModStaticFiles Include="$(MSBuildProjectDirectory)\config.json"
                             Condition="Exists('$(MSBuildProjectDirectory)\config.json')"/>
            <_ModStaticFiles Include="$(MSBuildProjectDirectory)\readme.txt"
                             Condition="Exists('$(MSBuildProjectDirectory)\readme.txt')"/>
            <_ModStaticFiles Include="$(MSBuildProjectDirectory)\changelog.txt"
                             Condition="Exists('$(MSBuildProjectDirectory)\changelog.txt')"/>
            <_ModStaticFiles Include="$(MSBuildProjectDirectory)\thumbnail.png"
                             Condition="Exists('$(MSBuildProjectDirectory)\thumbnail.png')"/>
        </ItemGroup>

        <Copy SourceFiles="@(_ModStaticFiles)"
              DestinationFolder="$(_ModDeployDir)"
              SkipUnchangedFiles="true"
              OverwriteReadOnlyFiles="true"/>

        <!-- Optional custom Unity AssetBundles. -->
        <ItemGroup Condition="'$(AssetBundlesSource)' != '' and Exists('$(AssetBundlesSource)')">
            <_AssetBundleFiles Remove="@(_AssetBundleFiles)"/>
            <_AssetBundleFiles Include="$(AssetBundlesSource)\**\*"/>
        </ItemGroup>

        <MakeDir Directories="$(_ModDeployDir)\AssetBundles"
                 Condition="'@(_AssetBundleFiles)' != ''"/>

        <Copy SourceFiles="@(_AssetBundleFiles)"
              DestinationFiles="@(_AssetBundleFiles->'$(_ModDeployDir)\AssetBundles\%(RecursiveDir)%(Filename)%(Extension)')"
              SkipUnchangedFiles="true"
              OverwriteReadOnlyFiles="true"
              Condition="'@(_AssetBundleFiles)' != ''"/>
    </Target>

    <!-- Convenient distributable ZIP -->
    <Target Name="CreateCoiReleasePackage"
            AfterTargets="DeployCoiMod"
            Condition="'$(IsCoiMod)' == 'true'
                  and '$(DeployToModsFolder)' == 'true'
                  and '$(CreateReleaseZip)' == 'true'
                  and '$(Configuration)' == 'Release'">
        <PropertyGroup>
            <_ModDeployDir>$(COIModsDir)\$(ModId)</_ModDeployDir>
            <_PackagePath>$(COIModsDir)\$(ModId)_$(ModVersion).zip</_PackagePath>
        </PropertyGroup>

        <Message Text="Creating release package: $(_PackagePath)" Importance="High"/>
        <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -Command &quot;Compress-Archive -Path '$(_ModDeployDir)' -DestinationPath '$(_PackagePath)' -Force&quot;"/>
    </Target>
</Project>
