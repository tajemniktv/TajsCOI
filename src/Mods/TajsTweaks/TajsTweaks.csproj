<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsCoiMod>true</IsCoiMod>

    <ModId>TajsTweaks</ModId>
    <ModVersion>0.1.0</ModVersion>
    <ModDisplayName>Taj's Tweaks</ModDisplayName>
    <ModDescription>Quality-of-life and simulation tweaks for Captain of Industry.</ModDescription>
    <ModAuthor>TajemnikTV</ModAuthor>
    <MinGameVersion>0.8.7</MinGameVersion>
    <MaxVerifiedGameVersion>0.8.7</MaxVerifiedGameVersion>

    <AssemblyName>$(ModId)</AssemblyName>
    <RootNamespace>TajsTweaks</RootNamespace>

    <!--
      TBD: move from ExampleMod.Unity to a dedicated TajsCOI.Unity project,
      either change the shared UnityProjectDir in Directory.Build.props or
      override it here.

      When custom bundles, uncomment and adjust:
      <AssetBundlesSource>$(UnityProjectDir)\AssetBundles</AssetBundlesSource>
    -->
  </PropertyGroup>

  <ItemGroup>
    <!-- CoI code mods conventionally use Harmony; the merged package is a single runtime DLL. -->
    <PackageReference Include="Lib.Harmony" Version="2.4.2"/>
  </ItemGroup>

  <Target Name="DeployTajsTweaksRuntimeDependencies"
          AfterTargets="DeployCoiMod"
          BeforeTargets="CreateCoiReleasePackage"
          Condition="'$(DeployToModsFolder)' == 'true' and Exists('$(TargetDir)0Harmony.dll')">
    <Copy SourceFiles="$(TargetDir)0Harmony.dll"
          DestinationFolder="$(COIModsDir)\$(ModId)"
          SkipUnchangedFiles="true"
          OverwriteReadOnlyFiles="true"/>
  </Target>

  <Target Name="CopyTajsTweaksRuntimeDependenciesToUnity"
          AfterTargets="CopyCoiDllToUnity"
          Condition="'$(CopyToUnityProject)' == 'true'
                  and Exists('$(UnityProjectDir)')
                  and Exists('$(TargetDir)0Harmony.dll')">
    <MakeDir Directories="$(UnityProjectDir)\Assets\DLLs"/>
    <Copy SourceFiles="$(TargetDir)0Harmony.dll"
          DestinationFolder="$(UnityProjectDir)\Assets\DLLs"
          SkipUnchangedFiles="true"
          OverwriteReadOnlyFiles="true"/>
  </Target>
</Project>
