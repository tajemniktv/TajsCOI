<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsCoiMod>true</IsCoiMod>

    <ModId>TajsTweaks</ModId>
    <ModVersion>0.1.0</ModVersion>
    <ModDisplayName>Taj's Tweaks</ModDisplayName>
    <ModDescription>Quality-of-life and simulation tweaks for Captain of Industry.</ModDescription>
    <ModAuthor>TajemnikTV</ModAuthor>
    <MinGameVersion>0.8.7</MinGameVersion>
    <MaxVerifiedGameVersion>0.8.7b</MaxVerifiedGameVersion>
    <PrimaryModClassName>TajsTweaksMod</PrimaryModClassName>

    <AssemblyName>$(ModId)</AssemblyName>
    <RootNamespace>TajsCOI.Tweaks</RootNamespace>

    <!--
      When custom bundles are used, uncomment and adjust:
      <AssetBundlesSource>$(UnityProjectDir)\AssetBundles</AssetBundlesSource>
    -->
  </PropertyGroup>

  <ItemGroup>
    <ModDependency Include="TajsCore&gt;=0.1.0"/>
    <ProjectReference Include="..\..\Libraries\TajsCOI.Common\TajsCOI.Common.csproj">
      <Private>false</Private>
    </ProjectReference>
    <PackageReference Include="Lib.Harmony" Version="2.4.2" ExcludeAssets="runtime"/>
    <Reference Include="Mafi.Unity">
      <HintPath>$(COIManagedDir)\Mafi.Unity.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(COIManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(COIManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIElementsModule">
      <HintPath>$(COIManagedDir)\UnityEngine.UIElementsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>TajsCOI.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
