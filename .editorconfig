# Heap Allocations Viewer is re-enabled only where allocations can perturb the game/profiler.
[src/Mods/TajsProfiler/Core/**/*.cs]
resharper_heapview_objectallocation = warning
resharper_heapview_boxingallocation = warning
resharper_heapview_delegateallocation = warning
resharper_heapview_closureallocation = warning

